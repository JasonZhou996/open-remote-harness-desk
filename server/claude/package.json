{
  "name": "@tri-web/claude-service",
  "private": true,
  "version": "1.37.3",
  "description": "三端 Web 的 Claude Code 会话、项目、附件与定时任务服务",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "preserver": "node scripts/promote-dist-server.mjs recover",
    "server": "node dist-server/server/index.js",
    "server:dev": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "server:dev-watch": "tsx watch --tsconfig server/tsconfig.json server/index.ts",
    "prebuild:server": "node -e \"require('node:fs').rmSync('dist-server.next', { recursive: true, force: true })\"",
    "build:server": "tsc -p server/tsconfig.json && tsc-alias -p server/tsconfig.json",
    "postbuild:server": "node scripts/promote-dist-server.mjs",
    "test": "tsx --tsconfig server/tsconfig.json --test \"server/**/*.test.ts\" \"server/**/*.test.js\"",
    "lint:server": "oxlint server/",
    "start": "npm run server:dev",
    "build": "npm run build:server",
    "typecheck": "tsc --noEmit -p server/tsconfig.json",
    "lint": "npm run lint:server",
    "postinstall": "node scripts/prune-bundled-claude.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@vscode/ripgrep": "^1.17.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.3",
    "express": "^4.18.2",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.6",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.1",
    "multer": "^2.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.7",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "tsc-alias": "^1.8.16",
    "oxlint": "^1.79.0",
    "eslint": "^9.39.3",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "@iarna/toml": "^2.2.5"
  }
}
