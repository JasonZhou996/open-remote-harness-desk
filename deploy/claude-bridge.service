[Unit]
Description=Claude Code backend for unified WebUI
Wants=network-online.target
After=network-online.target
PartOf=ai-webui.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@/server/claude
ExecStart=/usr/bin/npm run server:dev
Restart=always
RestartSec=3

[Install]
WantedBy=ai-webui.target
